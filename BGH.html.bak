    <!-- JAVASCRIPT XỬ LÝ MOBILE MENU -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var toggleBtn = document.querySelector('.vl-mobile-toggle');
            var menu = document.querySelector('.vl-menu');
            var menuItems = document.querySelectorAll('.vl-menu-item');

            if(toggleBtn) {
                toggleBtn.addEventListener('click', function() {
                    this.classList.toggle('active');
                    menu.classList.toggle('active');
                });
            }

            menuItems.forEach(function(item) {
                var link = item.querySelector('.vl-menu-link');
                var dropdown = item.querySelector('.vl-dropdown, .vl-mega-menu');
                if (link && dropdown) {
                    link.addEventListener('click', function(e) {
                        if (window.innerWidth <= 768) {
                            e.preventDefault();
                            var isActive = item.classList.contains('active');
                            menuItems.forEach(function(other) { other.classList.remove('active'); });
                            if (!isActive) { item.classList.add('active'); }
                        }
                    });
                }
            });
        });
    </script>
</body>
</html>